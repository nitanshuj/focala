SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_key
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL_NAME=gemini-3-flash-preview
GEMINI_BACKUP_MODEL_NAME=gemini-3.1-flash-lite
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourapp.onrender.com/api/calendar/callback
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
JWT_SECRET=your_jwt_secret

# Security: your deployed frontend URL (no trailing slash)
# Production example: https://focala.netlify.app
FRONTEND_URL=http://localhost:8080

# Security: comma-separated list of allowed CORS origins
# Production example: https://focala.netlify.app,https://www.focala.app
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Set to true ONLY for local development. NEVER set in production.
DEBUG=true